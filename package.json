{
  "name": "racket-life-local-first-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute spinventory-db --local --file=./worker/schema.sql",
    "db:migrate:remote": "wrangler d1 execute spinventory-db --remote --file=./worker/schema.sql"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "hono": "^4.13.13",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^4.149.0"
  }
}
